{
  "name": "alpinejs-emit",
  "version": "2.0.0",
  "description": "Emit `x-data` changes to other Alpine JS elements 📣",
  "keywords": [
    "Alpine",
    "Alpine JS",
    "Alpine JS Plugin",
    "Alpine JS Plugins",
    "Alpine JS Emit",
    "Alpine JS Emitter",
    "JavaScript Emit",
    "JavaScript Emitter"
  ],
  "license": "MIT",
  "author": "Mark Mead",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmead/alpinejs-emit.git"
  },
  "homepage": "https://github.com/markmead/alpinejs-emit#readme",
  "bugs": "https://github.com/markmead/alpinejs-emit/issues",
  "main": "dist/emit.cjs",
  "module": "dist/emit.mjs",
  "unpkg": "dist/emit.min.js",
  "exports": {
    ".": {
      "import": "./dist/emit.mjs",
      "require": "./dist/emit.cjs",
      "default": "./dist/emit.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "alpinejs": "^3.15.0",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.1.3"
}
